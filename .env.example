# Plantilla de configuración. Copia este archivo a .env y rellena los valores.
#   cp .env.example .env
#
# .env está en .gitignore y NUNCA se sube al repositorio.
# Este archivo sí se sube: documenta qué variables hacen falta, sin los valores.

POSTGRES_USER=mailpilot
POSTGRES_PASSWORD=cambia-esto-por-una-contrasena-aleatoria
POSTGRES_DB=mailpilot

# Cadena de conexión que usará SQLAlchemy.
# Debe coincidir con las tres variables de arriba.
# Puerto 5433: es el que publica docker-compose.yml en el host, porque el
# 5432 puede estar ocupado por un PostgreSQL instalado en la máquina.
DATABASE_URL=postgresql+psycopg://mailpilot:cambia-esto-por-una-contrasena-aleatoria@localhost:5433/mailpilot
